<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="PseudoCode.App.MainWindow"
        Title="PseudoCode"
        Icon="/Assets/logoPseudoCode.png"
        Width="1200"
        Height="760"
        MinWidth="760"
        MinHeight="480"
        CanResize="True"
        KeyDown="Window_KeyDown"
        Background="{StaticResource EditorBackground}">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#252526" />
    <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ActivityBackground" Color="#181818" />
    <SolidColorBrush x:Key="TopBarBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="TabBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="InsetBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="LineNumberBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="OutputBackground" Color="#111111" />
    <SolidColorBrush x:Key="VariablesBackground" Color="#151515" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#37373D" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#4B4B4B" />
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#5D5D5D" />
    <SolidColorBrush x:Key="BorderBrushMuted" Color="#3C3C3C" />
    <SolidColorBrush x:Key="TextPrimary" Color="#D4D4D4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9DA3AA" />
    <SolidColorBrush x:Key="LineNumberText" Color="#858585" />
    <SolidColorBrush x:Key="CaretBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#264F78" />
    <SolidColorBrush x:Key="AccentBlue" Color="#007ACC" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.command">
      <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.command:pointerover">
      <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ButtonHoverBorder}" />
    </Style>

    <Style Selector="Button.run-command">
      <Setter Property="Foreground" Value="#43D17A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.pause-command">
      <Setter Property="Foreground" Value="#FFD54A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.stop-command">
      <Setter Property="Background" Value="#111111" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.panel-title">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="14,12,14,8" />
    </Style>

    <Style Selector="Button.context-menu-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.context-menu-item:pointerover">
      <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button.context-menu-item:focus">
      <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ButtonHoverBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <LayoutTransformControl x:Name="AppScaleHost">
  <Grid x:Name="MainLayout" RowDefinitions="36,*,24" ColumnDefinitions="260,6,*,6,340">
    <Border Grid.Row="0" Grid.ColumnSpan="5" Background="{StaticResource TopBarBackground}" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
          <TextBlock Text="PseudoCode" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
          <Menu Background="Transparent" Foreground="{StaticResource TextSecondary}">
            <MenuItem Header="Archivo">
              <MenuItem Header="Nuevo algoritmo" Click="NewFile_Click" />
              <MenuItem Header="Abrir..." Click="OpenFile_Click" />
              <MenuItem x:Name="RecentFilesMenu" Header="Documentos recientes" />
              <Separator />
              <MenuItem Header="Guardar (Ctrl+G)" Click="SaveFile_Click" />
              <MenuItem Header="Cerrar archivo" Click="CloseFile_Click" />
            </MenuItem>
            <MenuItem Header="Editar">
              <MenuItem Header="Copiar (Ctrl+C)" Click="Copy_Click" />
              <MenuItem Header="Cortar (Ctrl+X)" Click="Cut_Click" />
              <MenuItem Header="Pegar (Ctrl+V)" Click="Paste_Click" />
              <MenuItem Header="Duplicar línea (Ctrl+D)" Click="DuplicateLine_Click" />
              <Separator />
              <MenuItem Header="Seleccionar todo" Click="SelectAll_Click" />
              <MenuItem Header="Formatear documento (Ctrl+Sift+F)" Click="FormatDocument_Click" />
              <MenuItem Header="Limpiar salida" Click="ClearOutput_Click" />
            </MenuItem>
            <MenuItem Header="Ejecutar">
              <MenuItem Header="Ejecutar algoritmo" Click="Run_Click" />
              <MenuItem Header="Pausar/continuar ejecución" Click="PauseExecution_Click" />
              <MenuItem Header="Detener ejecución" Click="StopExecution_Click" />
              <Separator />
              <MenuItem Header="Iniciar depuración" Click="StartDebug_Click" />
              <MenuItem Header="Paso a paso (F10)" Click="StepDebug_Click" />
              <MenuItem Header="Detener depuración" Click="StopDebug_Click" />
            </MenuItem>
            <MenuItem Header="Configuración">
              <MenuItem Header="Settings JSON" Click="SettingsJson_Click" />
              <MenuItem Header="Temas para el código fuente" Click="SourceThemes_Click" />
              <MenuItem Header="Configurar sintaxis" Click="SyntaxConfiguration_Click" />
              <Separator />
              <MenuItem Header="Carpeta de configuración" Click="SettingsConfiguration_Click" />
            </MenuItem>
            <MenuItem Header="Ayuda">
              <MenuItem Header="Mostrar u ocultar ayuda" Click="ToggleHelp_Click" />
              <MenuItem Header="Cargar ejemplo inicial" Click="LoadFirstHelpExample_Click" />
              <Separator />
              <MenuItem Header="Documentación" Click="Documentation_Click" />
              <MenuItem Header="Pseudolenguaje" Click="PseudoLanguageDocumentation_Click" />
              <MenuItem Header="Configuración JSON" Click="JsonConfiguration_Click" />
              <MenuItem Header="Notas de versión" Click="ReleaseNotes_Click" />
              <Separator />
              <MenuItem Header="Acerca de PseudoCode" Click="About_Click" />
            </MenuItem>
          </Menu>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button x:Name="ThemeToggleButton" Classes="command" Click="ThemeToggle_Click" Content="Modo claro" Padding="10,4" />
          <Button Classes="command" Click="ToggleHelp_Click" Content="?" Padding="10,4" ToolTip.Tip="Mostrar u ocultar ayuda" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Classes="panel-title" Text="EXPLORADOR" />
        <StackPanel Grid.Row="1" Margin="14,0,14,12" Spacing="8">
          <Button Classes="command" Click="NewFile_Click" Content="Nuevo algoritmo" HorizontalAlignment="Stretch" />
          <Button Classes="command" Click="OpenFile_Click" Content="Abrir..." HorizontalAlignment="Stretch" />
          <Button Classes="command" Click="SaveFile_Click" Content="Guardar" ToolTip.Tip="Guardar (Ctrl+G)" HorizontalAlignment="Stretch" />
        </StackPanel>

        <Border Grid.Row="2" Margin="14,0,14,12" Background="{StaticResource InsetBackground}" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1" CornerRadius="4">
          <ScrollViewer>
            <StackPanel x:Name="OpenFilesPanel" Margin="8" Spacing="6" />
          </ScrollViewer>
        </Border>

        <Border x:Name="MouseClickDiagnosticsPanel"
                Grid.Row="3"
                Margin="14,0,14,12"
                Padding="8"
                Background="{StaticResource InsetBackground}"
                BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="False">
          <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="DIAGNOSTICO MOUSE" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="command"
                      Click="CopyDiagnostics_Click"
                      Content="Copiar reporte"
                      Padding="8,4" />
              <Button Grid.Column="2"
                      Classes="command"
                      Click="ClearDiagnostics_Click"
                      Content="Limpiar"
                      Padding="8,4" />
            </Grid>
            <TextBox x:Name="MouseClickDiagnosticsTextBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="90"
                     MaxHeight="170"
                     Background="{StaticResource EditorBackground}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderBrushMuted}"
                     BorderThickness="1"
                     FontFamily="Cascadia Code,Consolas,monospace"
                     FontSize="12" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  Background="{StaticResource BorderBrushMuted}"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="42,*,6,210">
      <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer x:Name="EditorTabsScrollViewer"
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="EditorTabs_PointerWheelChanged">
            <StackPanel x:Name="EditorTabsPanel" Orientation="Horizontal" Height="42" />
          </ScrollViewer>
          <StackPanel x:Name="TopExecutionControls"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="8,0,12,0"
                      Spacing="8"
                      IsVisible="False">
            <Button x:Name="TopPauseExecutionButton"
                    Classes="command pause-command"
                    Click="PauseExecution_Click"
                    Content="Ⅱ Pausa"
                    ToolTip.Tip="Pausar o continuar la ejecución" />
            <Button Classes="command stop-command"
                    Click="StopExecution_Click"
                    Content="■ Stop"
                    ToolTip.Tip="Detener la ejecución actual" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="*,42">
        <edit:TextEditor Grid.Row="0"
                         x:Name="EditorTextBox"
                         ShowLineNumbers="True"
                         IsReadOnly="False"
                         Focusable="True"
                         TextChanged="Editor_TextChanged"
                         Background="{StaticResource EditorBackground}"
                         Foreground="{StaticResource TextPrimary}"
                         FontFamily="Cascadia Code,Consolas,monospace"
                         FontSize="15"
                         Padding="14,12"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />

        <Border Grid.Row="1"
                Background="{StaticResource EditorBackground}"
                BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="0,1,0,0"
                MinHeight="42"
                MaxHeight="42">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"
                      Spacing="8">
            <Button x:Name="RunExecutionButton" Classes="command run-command" Click="Run_Click" Content="▶ Ejecutar" />
            <Button x:Name="PauseExecutionButton" Classes="command pause-command" Click="PauseExecution_Click" Content="Ⅱ Pausa" ToolTip.Tip="Pausar o continuar la ejecución" IsEnabled="False" />
            <Button x:Name="StopExecutionButton" Classes="command stop-command" Click="StopExecution_Click" Content="■ Stop" ToolTip.Tip="Detener la ejecución actual" IsEnabled="False" />
            <Button Classes="command" Click="StartDebug_Click" Content="Depurar" ToolTip.Tip="Iniciar depuración paso a paso" />
            <Button Classes="command" Click="StepDebug_Click" Content="F10 Paso" ToolTip.Tip="Ejecutar la línea actual y avanzar" />
            <Button Classes="command" Click="SaveFile_Click" Content="Guardar" ToolTip.Tip="Guardar (Ctrl+G)" />
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Row="2"
                    Background="{StaticResource BorderBrushMuted}"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <Grid Grid.Row="3" RowDefinitions="34,*" Background="{StaticResource EditorBackground}">
        <Border BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,1,0,1" Background="{StaticResource PanelBackground}">
          <Grid ColumnDefinitions="2*,6,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0" VerticalAlignment="Center">
              <Button x:Name="OutputTabButton"
                      Content="SALIDA"
                      Click="OutputView_Click"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextPrimary}"
                      FontWeight="SemiBold"
                      Padding="0" />
              <Button x:Name="DiagnosticsTabButton"
                      Click="DiagnosticsView_Click"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextSecondary}"
                      Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="DIAGNOSTICOS" />
                  <Border x:Name="DiagnosticCountBadge"
                          IsVisible="False"
                          MinWidth="18"
                          Height="18"
                          CornerRadius="9"
                          Background="#DC2626"
                          Padding="5,0">
                    <TextBlock x:Name="DiagnosticCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="VARIABLES"
                       Foreground="{StaticResource TextSecondary}"
                       FontWeight="SemiBold"
                       Margin="14,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,6,*" Background="{StaticResource OutputBackground}">
          <Grid RowDefinitions="*,Auto">
            <Grid>
              <TextBox x:Name="OutputTextBox"
                       IsReadOnly="True"
                       IsTabStop="False"
                       TextWrapping="Wrap"
                       Background="{StaticResource OutputBackground}"
                       Foreground="{StaticResource TextPrimary}"
                       BorderThickness="0"
                       FontFamily="Cascadia Code,Consolas,monospace"
                       FontSize="13"
                       Padding="14"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <ScrollViewer x:Name="DiagnosticProblemsScroll"
                            IsVisible="False"
                            Background="{StaticResource OutputBackground}"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DiagnosticProblemsPanel" Margin="10" Spacing="8" />
              </ScrollViewer>
            </Grid>

            <Border Grid.Row="1"
                    x:Name="ConsoleInputPanel"
                    IsVisible="False"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrushMuted}"
                    BorderThickness="0,1,0,0"
                    Padding="10">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="ConsoleInputPrompt"
                           Text="Entrada:"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         x:Name="ConsoleInputTextBox"
                         Watermark="Escribe un valor y presiona Enter"
                         KeyDown="ConsoleInput_KeyDown"
                         Background="{StaticResource EditorBackground}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderBrushMuted}"
                         FontFamily="Cascadia Code,Consolas,monospace" />
                <Button Grid.Column="2"
                        Classes="command"
                        Click="SendConsoleInput_Click"
                        Content="Enviar" />
              </Grid>
            </Border>
          </Grid>
          <GridSplitter Grid.Column="1"
                        Background="{StaticResource BorderBrushMuted}"
                        ResizeDirection="Columns"
                        ResizeBehavior="PreviousAndNext"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

          <TextBox Grid.Column="2"
                   x:Name="VariablesTextBox"
                   IsReadOnly="True"
                   IsTabStop="False"
                   TextWrapping="Wrap"
                   Background="{StaticResource VariablesBackground}"
                   Foreground="{StaticResource TextSecondary}"
                   BorderThickness="0"
                   FontFamily="Cascadia Code,Consolas,monospace"
                   FontSize="13"
                   Padding="14"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
      </Grid>

      <Border x:Name="EmptyWorkspacePanel"
              Grid.Row="1"
              Grid.RowSpan="3"
              Background="{StaticResource EditorBackground}"
              IsVisible="False"
              ZIndex="10">
        <Grid>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="18">
            <Image Source="/Assets/logoPseudoCode.png"
                   Width="180"
                   Height="180"
                   Opacity="0.14"
                   Stretch="Uniform" />
            <TextBlock Text="No hay algoritmos abiertos"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="26">
                <TextBlock Text="Nuevo algoritmo"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Ctrl + N"
                           Foreground="{StaticResource TextPrimary}"
                           Background="{StaticResource ButtonBackground}"
                           Padding="8,3"
                           VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="26">
                <TextBlock Text="Abrir archivo"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Archivo > Abrir"
                           Foreground="{StaticResource TextPrimary}"
                           Background="{StaticResource ButtonBackground}"
                           Padding="8,3"
                           VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Canvas x:Name="EditorContextMenuOverlay"
              Grid.Row="1"
              Grid.RowSpan="3"
              Background="Transparent"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsVisible="False"
              ZIndex="30"
              PointerPressed="EditorContextMenuOverlay_PointerPressed">
        <Border x:Name="EditorContextMenuPopup"
                IsVisible="False"
                MinWidth="220"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource ButtonBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6">
          <StackPanel Spacing="2"
                      HorizontalAlignment="Stretch">
            <Button x:Name="EditorContextMenuFirstItem" Classes="context-menu-item" Click="Copy_Click" Content="Copiar (Ctrl+C)" />
            <Button x:Name="EditorContextMenuCutItem" Classes="context-menu-item" Click="Cut_Click" Content="Cortar (Ctrl+X)" />
            <Button x:Name="EditorContextMenuPasteItem" Classes="context-menu-item" Click="Paste_Click" Content="Pegar (Ctrl+V)" />
            <Button x:Name="EditorContextMenuDuplicateItem" Classes="context-menu-item" Click="DuplicateLine_Click" Content="Duplicar linea (Ctrl+D)" />
            <Border Height="1" Margin="4,4" Background="{StaticResource BorderBrushMuted}" />
            <Button x:Name="EditorContextMenuFormatItem" Classes="context-menu-item" Click="FormatDocument_Click" Content="Formatear documento (Ctrl+Shift+F)" />
          </StackPanel>
        </Border>
      </Canvas>
    </Grid>

    <GridSplitter Grid.Row="1"
                  Grid.Column="3"
                  Background="{StaticResource BorderBrushMuted}"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

    <Border x:Name="HelpPanel"
            Grid.Row="1"
            Grid.Column="4"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource BorderBrushMuted}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,250,6,*">
        <Grid ColumnDefinitions="*,Auto" Margin="14,12,14,8">
          <TextBlock Text="AYUDA POR TEMAS"
                     Foreground="{StaticResource TextSecondary}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="command" Click="ToggleHelp_Click" Content="Ocultar" Padding="8,4" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="14,0,14,10">
          <StackPanel Spacing="12">
            <TextBlock Text="PLANTILLAS"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <WrapPanel x:Name="TemplatesPanel" Orientation="Horizontal" />

            <TextBlock Text="LISTADOS"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <TextBlock Text="Funciones y comandos"
                       Foreground="{StaticResource TextPrimary}"
                       FontWeight="SemiBold" />
            <ItemsControl x:Name="CommandsList" />
            <TextBlock Text="Operadores"
                       Foreground="{StaticResource TextPrimary}"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <ItemsControl x:Name="OperatorsList" />
          </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="2"
                      Background="{StaticResource BorderBrushMuted}"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <ScrollViewer Grid.Row="3" Margin="14,10,14,14">
          <StackPanel x:Name="HelpTopicsPanel" Spacing="10" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="5" Background="{StaticResource AccentBlue}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
        <TextBlock Text=".NET 8 + Avalonia" Foreground="White" VerticalAlignment="Center" FontSize="12" />
        <TextBlock Grid.Column="1"
                   x:Name="WindowStateText"
                   Text="Listo"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="12" />
        <TextBlock Grid.Column="2" x:Name="CursorStatusText" Text="Linea 1, Columna 1" Foreground="White" VerticalAlignment="Center" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
